PORT=3001
# pino log level (trace/debug/info/warn/error/silent). Defaults to "info"
# ("silent" automatically when NODE_ENV=test).
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (credentials: true requires
# an explicit origin, not "*"). Defaults to the Vite dev server if unset.
CORS_ORIGIN="http://localhost:5173"
DATABASE_URL="postgresql://benifits:benifits@localhost:5432/benifits?schema=public"
JWT_ACCESS_SECRET="change-me-to-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="change-me-to-a-different-random-64-char-hex-string"
USDA_FDC_API_KEY=
ANTHROPIC_API_KEY=
SPOONACULAR_API_KEY=
NEWS_API_KEY=
# Optional - PubMed's E-utilities work without a key, this only raises
# NCBI's rate limit (10 req/s instead of 3 req/s).
PUBMED_API_KEY=
YOUTUBE_API_KEY=
# Optional - Sentry error tracking is fully disabled (no-op) until this is set.
SENTRY_DSN=

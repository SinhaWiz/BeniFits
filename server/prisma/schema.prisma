// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GUEST
  USER
  NUTRITIONIST
  DOCTOR
  COACH
  ADMIN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Goal {
  LOSE_WEIGHT
  GAIN_MUSCLE
  MAINTAIN_WEIGHT
  HEALTHY_EATING
  IMPROVE_STAMINA
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ExerciseCategory {
  GYM
  HOME
  CARDIO
  HIIT
  YOGA
  STRETCHING
}

enum DayCategory {
  GYM
  HOME
  CARDIO
  HIIT
  YOGA
  STRETCHING
  REST
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AiChatRole {
  USER
  ASSISTANT
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String?
  role              Role               @default(USER)
  avatar            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  healthProfile     HealthProfile?
  progressEntries   ProgressEntry[]
  dietPlans         DietPlan[]
  workoutPlans      WorkoutPlan[]
  aiConversation    AiConversation?
  aiWeightLossPlans AiWeightLossPlan[]
  expertProfile     ExpertProfile?
}

model HealthProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  age             Int?
  heightCm        Float?
  weightKg        Float?
  bmi             Float?
  bloodGroup      String?
  activityLevel   ActivityLevel?
  goal            Goal?
  sleepHours      Float?
  waterIntakeMl   Int?
  diseases        String[]       @default([])
  allergies       String[]       @default([])
  foodPreferences String[]       @default([])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProgressEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt      DateTime @db.Date
  weightKg        Float?
  bmi             Float?
  bodyFatPercent  Float?
  waistCm         Float?
  sleepHours      Float?
  waterIntakeMl   Int?
  exerciseMinutes Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, recordedAt])
  @@index([userId, recordedAt])
}

model DietPlan {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  targetCalories Int?
  targetProteinG Float?
  targetFatG     Float?
  targetCarbsG   Float?
  meals          DietPlanMeal[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
}

model DietPlanMeal {
  id          String   @id @default(cuid())
  dietPlanId  String
  dietPlan    DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  mealType    MealType
  description String
  fdcId       Int?
  calories    Int?
  proteinG    Float?
  fatG        Float?
  carbsG      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dietPlanId])
}

model Exercise {
  id                   String                @id @default(cuid())
  name                 String
  category             ExerciseCategory
  difficulty           Difficulty
  muscleGroup          String?
  defaultSets          Int?
  defaultReps          Int?
  durationMinutes      Int?
  description          String?
  createdAt            DateTime              @default(now())
  workoutPlanExercises WorkoutPlanExercise[]

  @@index([category, difficulty])
}

model WorkoutPlan {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  days      WorkoutPlanDay[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}

model WorkoutPlanDay {
  id            String                @id @default(cuid())
  workoutPlanId String
  workoutPlan   WorkoutPlan           @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  dayNumber     Int
  category      DayCategory
  exercises     WorkoutPlanExercise[]

  @@index([workoutPlanId])
}

model WorkoutPlanExercise {
  id               String         @id @default(cuid())
  workoutPlanDayId String
  workoutPlanDay   WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  sets             Int?
  reps             Int?
  durationMinutes  Int?

  @@index([workoutPlanDayId])
}

model AiConversation {
  id        String          @id @default(cuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AiChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiChatRole
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AiWeightLossPlan {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetWeightKg Float
  durationWeeks  Int
  summary        String                 @db.Text
  weeks          AiWeightLossPlanWeek[]
  createdAt      DateTime               @default(now())

  @@index([userId])
}

model AiWeightLossPlanWeek {
  id                 String           @id @default(cuid())
  planId             String
  plan               AiWeightLossPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber         Int
  targetCalories     Int
  targetProteinG     Float
  workoutSummary     String           @db.Text
  walkingGoalMinutes Int
  waterGoalMl        Int
  sleepGoalHours     Float
  notes              String?          @db.Text

  @@index([planId])
}

model ExpertProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty           String
  focusArea           String
  bio                 String   @db.Text
  credentials         String?  @db.Text
  yearsExperience     Int?
  isAcceptingBookings Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([specialty])
}
